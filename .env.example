# Copy to .env and fill in. NEVER commit real secrets.

# --- Local database (deploy/compose) ---
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=postgres

# --- API ---
API_ADDR=:8080
DATABASE_URL=postgres://postgres:change-me-locally@localhost:5432/postgres?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002,http://localhost:3003,http://127.0.0.1:3003,http://localhost:3004,http://127.0.0.1:3004

# --- Supabase (Phase 1+) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRY=3600
SECRET_KEY_BASE=change-me-in-production-must-be-at-least-64-characters-long
API_EXTERNAL_URL=http://localhost:8000/auth
SITE_URL=http://localhost:3002
ADDITIONAL_REDIRECT_URLS=*
# `make dev-full` derives a short-lived service-role JWT from JWT_SECRET for
# server-side driver invitations. For direct Compose usage, generate one with:
# JWT_SECRET="$JWT_SECRET" python3 docs-site/scripts/mint_service_role_jwt.py
# GOTRUE_ADMIN_URL=http://auth:9999
# SUPABASE_URL=http://localhost:8000
# SUPABASE_ANON_KEY=
# SUPABASE_JWT_JWKS_URL=

# --- Portal (Phase 4+) ---
PORTAL_PORT=3002
# Public browser-facing URLs are embedded when the portal image is built.
# PORTAL_API_BASE_URL=http://localhost:8080
# PORTAL_EXPORTER_BASE_URL=http://localhost:8090
# PORTAL_SUPABASE_URL=http://localhost:8080/auth
# SUPABASE_ANON_KEY=
# PORTAL_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
