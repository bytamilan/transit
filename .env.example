# Copy to .env and fill in. NEVER commit real secrets.

# --- Local database (deploy/compose) ---
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=postgres

# --- API ---
API_ADDR=:8080
DATABASE_URL=postgres://postgres:change-me-locally@localhost:5432/postgres?sslmode=disable

# --- Supabase (Phase 1+) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRY=3600
SECRET_KEY_BASE=change-me-in-production-must-be-at-least-64-characters-long
API_EXTERNAL_URL=http://localhost:8000/auth
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=*
