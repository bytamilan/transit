# Supabase Auth (GoTrue) — same project the Go API verifies JWTs against.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the Go API (services/api) — the portal never talks to Postgres
# directly, only through this API with the signed-in user's Supabase JWT.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Base URL of the exporter service (Phase 10) — serves per-agency GTFS.zip
# and the GTFS-RT ServiceAlerts stub. Backs the public /datasets page.
NEXT_PUBLIC_EXPORTER_BASE_URL=http://localhost:8090
